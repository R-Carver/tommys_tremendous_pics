{
  "name": "tommys-pics",
  "private": true,
  "version": "0.2.0",
  "description": "Portfolio website for a photographer. Static frontend + Cloudflare Worker backend, images in R2.",
  "type": "module",
  "scripts": {
    "mock:prepare": "node frontend/mock/prepare-mock-data.mjs",
    "mock": "node frontend/mock/mock-server.mjs",
    "seed": "node backend/scripts/seed.mjs",
    "seed:remote": "node backend/scripts/seed.mjs --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:e2e": "playwright test",
    "test:e2e:mock": "MOCK=1 BASE_URL=http://localhost:8788 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "sharp": "^0.33.5",
    "wrangler": "^4.151.2"
  }
}
